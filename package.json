{
  "name": "my-networth",
  "productName": "My Networth",
  "version": "0.1.0",
  "description": "Open-source personal finance & investment portfolio tracker. Offline-first desktop app for macOS and Windows.",
  "author": "My Networth Contributors",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview --port 4173 --open",
    "build": "tsc -b && vite build && npm run build:electron",
    "typecheck": "tsc -b --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "electron:dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build:electron": "tsc -p electron/tsconfig.json && node -e \"require('fs').copyFileSync('electron/package.json','dist-electron/package.json')\"",
    "predist": "npm run build",
    "dist": "electron-builder",
    "dist:mac": "npm run predist && electron-builder --mac",
    "dist:win": "npm run predist && electron-builder --win",
    "dist:dir": "npm run predist && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.33.0",
    "lucide-react": "^0.441.0",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "uuid": "^9.0.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.15",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.24.2",
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "wait-on": "^7.2.0"
  }
}
